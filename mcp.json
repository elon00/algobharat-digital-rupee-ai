{
  "mcpServers": {
    "algobharat-digital-rupee-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Algorand",
        "PROJECT_TICKER": "ABRUPEE"
      },
      "tools": [
        {
          "name": "verify_abrupee_invariants",
          "description": "Verifies deterministic invariants for AlgoBharat Digital Rupee AI on Algorand."
        },
        {
          "name": "execute_abrupee_action",
          "description": "Executes authenticated CBDC state transition."
        }
      ]
    }
  }
}